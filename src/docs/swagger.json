{
  "openapi": "3.0.0",
  "info": {
    "title": "API MiniBlog",
    "version": "1.0.0",
    "description": "Documentación interactiva de endpoints para autores y publicaciones"
  },
  "servers": [
    {
      "url": "https://proyectom2neidydiaz-production.up.railway.app",
      "description": "Servidor de producción en Railway"
    },

    {
      "url": "http://localhost:3000",
      "description": "Servidor en desarrollo"
    
    }
  ],
  "paths": {
    "/authors": {
      "get": {
        "summary": "Listar todos los autores",
        "responses": { "200": { "description": "Éxito" } }
      },
      "post": {
        "summary": "Crear un autor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Maria Perez" },
                  "email": { "type": "string", "example": "maria@example.com" },
                  "bio": { "type": "string", "example": "Desarrolladora Web" }
                },
                "required": ["name", "email"]
              }
            }
          }
        },
        "responses": { "201": { "description": "Autor creado" } }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Obtener autor por ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Éxito" } }
      },
      "put": {
        "summary": "Actualizar autor",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "bio": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Éxito" } }
      },
      "delete": {
        "summary": "Eliminar autor",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Éxito" } }
      }
    },
    "/posts": {
      "get": {
        "summary": "Listar todas las publicaciones",
        "responses": { "200": { "description": "Éxito" } }
      },
      "post": {
        "summary": "Crear una publicación",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "author_id": { "type": "integer", "example": 1 },
                  "title": { "type": "string", "example": "Mi primer post" },
                  "content": { "type": "string", "example": "Contenido del post" },
                  "published": { "type": "boolean", "example": true }
                },
                "required": ["author_id", "title", "content"]
              }
            }
          }
        },
        "responses": { "201": { "description": "Publicación creada" } }
      }
    }
  }
}